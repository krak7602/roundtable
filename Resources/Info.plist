<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Roundtable</string>
    <key>CFBundleDisplayName</key>
    <string>Roundtable</string>
    <key>CFBundleIdentifier</key>
    <string>dev.rahulkrishna.roundtable</string>
    <key>CFBundleExecutable</key>
    <string>Roundtable</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.3</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu-bar-only agent app: no dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown in the permission prompt the first time Roundtable focuses a
         session in iTerm2 or Terminal, or types an answer into one. Required:
         without it macOS denies the request outright rather than asking. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Roundtable needs permission to control your terminal so it can bring the right session to the front and answer prompts for you.</string>
</dict>
</plist>
